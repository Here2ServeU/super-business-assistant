# Super Business Assistant: every variable the app reads. No real values here, ever.
# Local: copy to .env and fill in. Production: set these in Vercel → Project → Settings → Environment Variables.

# --- required ---
DATABASE_URL=               # Postgres with pgvector (Neon pooled URL in production)
AUTH_SECRET=                # long random string: openssl rand -hex 32
ENCRYPTION_KEY=             # long random string for OAuth tokens at rest: openssl rand -hex 32
CRON_SECRET=                # long random string; Vercel Cron sends it as a Bearer token

# --- AI (without a key the app runs on the free offline model) ---
OPENAI_API_KEY=
AI_PROVIDER=                # optional: "openai" or "offline" (default: openai when a key is set)
MODEL_SMALL=                # optional, default gpt-6-luna (sorting, simple drafts, summaries)
MODEL_LARGE=                # optional, default gpt-6.1-sol (complex drafts)

# --- Gmail (Google Cloud OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=                    # e.g. https://your-app.vercel.app (OAuth redirect = APP_URL/api/mail/google/callback)

# --- signup ---
SIGNUP_ACCESS_CODE=         # optional; when set, /signup requires it (link: /signup?code=YOUR_CODE)

# --- email: signup verification codes (required on Vercel for signup) + owner pings ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=          # a sender on a domain verified in Resend, e.g. Super Business Assistant <hello@yourdomain.com>

# --- text messages: phone verification at signup (required on Vercel for signup) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=  # Twilio Console → Verify → Services (starts with VA)

# --- seeding (npm run seed); used once to create logins, never committed ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_DEMO_EMAIL=            # default demo@northstar.example
SEED_DEMO_PASSWORD=
SEED_USE_AI=                # set to 1 to let the seed spend real AI calls (default: offline)

# --- tests ---
TEST_DATABASE_URL=          # default postgres://sba:sba@localhost:54329/sba_test
